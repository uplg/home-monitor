// Streamed MP3 playback: clapier serves the file, the TCP stream
// fills a chunk queue, and the VS1003 codec drains it through
// playFeed. The one real-time piece of the rabbit: the file plays
// while it downloads, with a small prebuffer against radio hiccups.
//
// Codec contract (vaudio.c + hal/audio.c): playStart arms the
// callback and turns the amplifier on; the C side calls the callback
// with the free FIFO space whenever it wants bytes; playFeed returns
// how many bytes it actually took; playFeed nil is the end-of-file
// mark; sndVol is VS1003 attenuation, 0 loudest.

const AUDIO_PREBUFFER = 8192;;   // bytes buffered before the music starts
const AUDIO_MAX_BUF = 200000;;   // beyond this the stream is cut, not the heap

const AUD_IDLE = 0;;
const AUD_BUFFER = 1;;   // stream open, waiting for the prebuffer
const AUD_PLAY = 2;;     // codec fed as chunks arrive

// Two-list queue: chunks pushed on _aud_in, drained from _aud_out,
// flipped when the out side runs dry. O(1) amortized either way.
var _aud_state = 0;;
var _aud_in = nil;;
var _aud_out = nil;;
var _aud_index = 0;;     // read offset inside the head of _aud_out
var _aud_bytes = 0;;     // buffered and not yet fed
var _aud_eof = 0;;       // the http stream has ended
var _aud_conn = nil;;
var audio_vol = 40;;     // default attenuation: audible, not a siren
var stat_audio_bytes = 0;;

proto _aud_cb 1;;

#ifdef SIMU
fun _aud_hw_start = 0;;
fun _aud_hw_feed s i = (strlen s) - i;;
fun _aud_hw_eof = 0;;
fun _aud_hw_stop = 0;;
fun _aud_hw_vol v = 0;;
fun audio_playtime = 0;;
#else
fun _aud_hw_start = playStart 1024 #_aud_cb;;
fun _aud_hw_feed s i = playFeed s i nil;;
fun _aud_hw_eof = playFeed nil nil nil;;
fun _aud_hw_stop = playStop;;
fun _aud_hw_vol v = sndVol v;;
fun audio_playtime = playTime;;
#endif

fun _aud_pop_out =
    if _aud_out != nil then 1
    else if _aud_in == nil then 0
    else (set _aud_out = _http_rev _aud_in nil; set _aud_in = nil; 1);;

// The codec is hungry: feed it the head chunk, advance by what it
// actually took. The C side repeats the call while progress is made.
fun _aud_cb free =
    if !(_aud_pop_out) then
    (
        if _aud_eof && (_aud_state == AUD_PLAY) then
        (
            _aud_hw_eof;
            set _aud_state = AUD_IDLE;
            log_send "audio: done";
            0
        )
        else 0
    )
    else
    let hd _aud_out -> chunk in
    let _aud_hw_feed chunk _aud_index -> pushed in
    (
        set _aud_index = _aud_index + pushed;
        set _aud_bytes = _aud_bytes - pushed;
        if _aud_index >= (strlen chunk) then
            (set _aud_out = tl _aud_out; set _aud_index = 0; 0)
        else 0;
        0
    );;

fun _aud_start_codec =
    set _aud_state = AUD_PLAY;
    _aud_hw_vol audio_vol;
    _aud_hw_start;
    0;;

fun _aud_chunk data =
    if _aud_state == AUD_IDLE then 0
    else
    (
        set _aud_in = data :: _aud_in;
        set _aud_bytes = _aud_bytes + (strlen data);
        set stat_audio_bytes = stat_audio_bytes + (strlen data);
        if _aud_bytes > AUDIO_MAX_BUF then
        (
            // The source outruns the codec by too much: cut the
            // stream and let the queued tail play out.
            log_send "audio: buffer cap, cutting stream";
            set _aud_eof = 1;
            if _aud_conn != nil then (tcp_close _aud_conn; set _aud_conn = nil; 0) else 0
        )
        else if (_aud_state == AUD_BUFFER) && (_aud_bytes >= AUDIO_PREBUFFER) then
            _aud_start_codec
        else 0
    );;

fun _aud_done status =
    set _aud_eof = 1;
    set _aud_conn = nil;
    if _aud_state == AUD_BUFFER then
    (
        // File shorter than the prebuffer, or an error: play what we
        // have, if anything.
        if (_aud_bytes > 0) && (status == 200) then _aud_start_codec
        else (set _aud_state = AUD_IDLE;
              log_send (strcat "audio: stream ended " (itoa status)))
    )
    else 0;;

fun audio_stop =
    if _aud_state != AUD_IDLE then
    (
        set _aud_state = AUD_IDLE;
        _aud_hw_stop;
        if _aud_conn != nil then (tcp_close _aud_conn; set _aud_conn = nil; 0) else 0
    )
    else 0;
    set _aud_in = nil; set _aud_out = nil;
    set _aud_index = 0; set _aud_bytes = 0; set _aud_eof = 0;
    0;;

// Stream a path from clapier and play it as it lands.
fun audio_play path =
    audio_stop;
    set _aud_state = AUD_BUFFER;
    set _aud_conn = http_stream CLAPIER_IP 80
        (strcatlist path :: "?m=" :: (mac_str net_mac) :: nil)
        #_aud_chunk #_aud_done;
    log_send (strcat "audio: streaming " path);
    1;;

fun audio_status =
    if _aud_state == AUD_IDLE then "idle"
    else strcatlist
        (if _aud_state == AUD_BUFFER then "buffering " else "playing ") ::
        (itoa _aud_bytes) :: "B" :: nil;;
