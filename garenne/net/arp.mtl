// ARP: answer who-has for our IP, remember peers we exchange with,
// announce ourselves at init. Frame offsets are absolute (LLC = 8
// bytes): op@14, sender mac@16, sender ip@22, target ip@32; a full
// packet is 36 bytes.

const ARP_OP_REQUEST = 1;;
const ARP_OP_REPLY = 2;;

const ARP_TTL_MS = 600000;;  // entries age out after 10 minutes
const ARP_CACHE_MAX = 8;;

var _arp_cache = nil;;  // list of [ip mac born_ms], freshest first

fun _arp_find l ip now =
    if l == nil then nil
    else let hd l -> [cip cmac born] in
    if (!strcmp cip ip) && ((now - born) < ARP_TTL_MS) then cmac
    else _arp_find (tl l) ip now;;

fun arp_lookup ip = _arp_find _arp_cache ip time_ms;;

fun _arp_drop l ip =
    if l == nil then nil
    else let hd l -> [cip _ _] in
    if !strcmp cip ip then _arp_drop (tl l) ip
    else (hd l) :: _arp_drop (tl l) ip;;

// Refresh on every sighting: drop the old entry, cons the new one,
// keep the cache small.
fun _arp_cache_put ip mac =
    set _arp_cache = list_take ([ip mac time_ms] :: (_arp_drop _arp_cache ip)) ARP_CACHE_MAX;
    0;;

fun _arp_frame op sha spa tha tpa =
    strcatlist LLC_ARP ::
        "\$00\$01\$08\$00\$06\$04" ::  // ethernet / ipv4 / lengths 6 and 4
        (word2 op) ::
        sha :: spa :: tha :: tpa :: nil;;

// Only packets targeting our IP concern us: cache the sender, and if it
// is a request, return the unicast reply [txframe macdst].
fun arp_input frame macsrc =
    if (strlen frame) < 36 then nil
    else if !strcmp (strsub frame 32 4) NET_IP then
    (
        _arp_cache_put (strsub frame 22 4) (strsub frame 16 6);
        if (strgetword frame 14) == ARP_OP_REQUEST then
            let strsub frame 16 6 -> peer_mac in
            let _arp_frame ARP_OP_REPLY net_mac NET_IP peer_mac (strsub frame 22 4) -> tx in
            [tx peer_mac]
        else nil
    )
    else nil;;

// Who-has, broadcast. The answer lands in the cache via arp_input;
// callers poll arp_lookup (tcp does, on its timer).
fun arp_request ip =
    netSend (_arp_frame ARP_OP_REQUEST net_mac NET_IP "\$00\$00\$00\$00\$00\$00" ip)
        0 nil MAC_BROADCAST 0 1;;

// Gratuitous request: tell the LAN our IP moved in with this MAC.
fun arp_announce =
    netSend (_arp_frame ARP_OP_REQUEST net_mac NET_IP "\$00\$00\$00\$00\$00\$00" NET_IP)
        0 nil MAC_BROADCAST 0 1;;
