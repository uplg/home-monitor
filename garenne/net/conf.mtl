// The flash config sector, the rabbit's identity papers: server URL,
// network settings, SSID and keys. Read through the load native — on
// device sysLoad ignores the file name and always returns the 226-byte
// EEPROM config sector; in the simulator it reads a real file (absent,
// so all zeros). The parsers are pure so tests feed them a fabricated
// sector. Offsets per the Violet boot source, cross-checked on real
// hardware. The PMK is handed to netAuth and never logged.

const CONF_LENGTH = 226;;
const CONF_OFF_SERVER = 0;;   // 41 bytes, platform URL, NUL terminated
const CONF_OFF_SSID = 58;;    // 32 bytes, NUL padded
const CONF_OFF_AUTH = 90;;
const CONF_OFF_CRYPT = 91;;
const CONF_OFF_PMK = 175;;    // 32 bytes
const CONF_OFF_MAGIC = 207;;

const CRYPT_NONE = 0;;
const CRYPT_WEP = 16;;
const CRYPT_WPA = 32;;
const CRYPT_WPA2 = 64;;

fun conf_read =
    let strnew CONF_LENGTH -> buf in
    (
        load buf 0 "conf.bin" 0 CONF_LENGTH;
        buf
    );;

// A NUL-terminated field of at most maxlen bytes.
fun conf_str s off maxlen =
    let strfind s off "\0" 0 nil -> z in
    let if (z == nil) || (z < 0) || ((z - off) > maxlen) then maxlen else z - off -> n in
    strsub s off n;;

fun conf_server s = conf_str s CONF_OFF_SERVER 41;;
fun conf_ssid s = conf_str s CONF_OFF_SSID 32;;
fun conf_auth s = strget s CONF_OFF_AUTH;;
fun conf_crypt s = strget s CONF_OFF_CRYPT;;
fun conf_pmk s = strsub s CONF_OFF_PMK 32;;
fun conf_magic s = strget s CONF_OFF_MAGIC;;

fun _quad_digits h i j =
    if i >= j then 1
    else let strget h i -> ch in
    if (ch >= 48) && (ch <= 57) then _quad_digits h (i + 1) j
    else 0;;

fun _quad_num h i j =
    if (j <= i) || ((j - i) > 3) then nil
    else if !(_quad_digits h i j) then nil
    else let atoi (strsub h i (j - i)) -> v in
    if v > 255 then nil else v;;

// A dotted quad as a 4-byte string, or nil.
fun _quad h =
    let strfind h 0 "." 0 nil -> a in
    if (a == nil) || (a <= 0) then nil
    else let strfind h (a + 1) "." 0 nil -> b in
    if (b == nil) || (b <= (a + 1)) then nil
    else let strfind h (b + 1) "." 0 nil -> c in
    if (c == nil) || (c <= (b + 1)) then nil
    else let _quad_num h 0 a -> q0 in
    let _quad_num h (a + 1) b -> q1 in
    let _quad_num h (b + 1) c -> q2 in
    let _quad_num h (c + 1) (strlen h) -> q3 in
    if (q0 == nil) || (q1 == nil) || (q2 == nil) || (q3 == nil) then nil
    else strcatlist (ctoa q0) :: (ctoa q1) :: (ctoa q2) :: (ctoa q3) :: nil;;

// The server field's host part as a 4-byte IP when it is a dotted quad
// (our LAN case); nil when it is a hostname — we have no DNS and no
// need for one yet. The real EEPROM carries "ip:port/path", so the
// host stops at '/' or ':'.
fun conf_server_ip s =
    let conf_server s -> url in
    let strfind url 0 "/" 0 nil -> sl in
    let if (sl == nil) || (sl < 0) then url else strsub url 0 sl -> hostport in
    let strfind hostport 0 ":" 0 nil -> co in
    let if (co == nil) || (co < 0) then hostport else strsub hostport 0 co -> host in
    _quad host;;
