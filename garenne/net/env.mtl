// The boot bytecode hands its network state to the application through
// the env register: ip[0..3] mask[4..7] gateway[8..11] dns[12..15],
// followed by its scan results. That is how applications of the
// 0.0.0.13 flash boot inherit the DHCP lease without redoing it.
// Cleared after consumption to free the RAM.

var env_inherited = 0;;

fun env_init =
    let envget -> env in
    if (env != nil) && ((strlen env) >= 16) then
    (
        set NET_IP = strsub env 0 4;
        set net_mask = strsub env 4 4;
        set NET_BCAST = ip_bcast NET_IP net_mask;
        set net_gateway = strsub env 8 4;
        set net_dns = strsub env 12 4;
        envset nil;
        set env_inherited = 1;
        1
    )
    else 0;;
