// The link watchdog: the lesson of the night the radio RX died while
// netState kept saying 4. Health is defined by received frames, not by
// what the driver claims. The ladder: RX silence -> ARP-probe the
// gateway -> declare the radio dead -> reassociate from the config
// sector (netScan + netAuth) -> after repeated failures, the last
// resort that provably heals: reboot (the boot refetches bc.jsp and
// rebuilds the association in C).

// rt2501 link states, per the Violet wifi driver spec (vendor/violet).
const NET_CONNECTED = 4;;
const NET_SCANNING = 2;;
const NET_CONNECTING = 3;;

const LINK_CHECK_MS = 2000;;         // watchdog cadence
const LINK_RX_PROBE_MS = 30000;;     // silence before probing starts
const LINK_RX_DEAD_MS = 90000;;      // silence before the radio is declared dead
const LINK_PROBE_EVERY_MS = 10000;;  // probe spacing inside the probe zone
const LINK_REASSOC_GRACE_MS = 20000;;// time a reassoc gets to produce RX
const LINK_REBOOT_AFTER = 2;;        // failed reassocs before rebooting

const LINK_ACT_NONE = 0;;
const LINK_ACT_PROBE = 1;;
const LINK_ACT_REASSOC = 2;;
const LINK_ACT_REBOOT = 3;;

// The reboot native demands these two keys (checked by the VM itself,
// vendor/nabgcc vinterp.c OPreboot) so no stray call can reboot us.
const REBOOT_KEY1 = 0x0407FE58;;
const REBOOT_KEY2 = 0x13FB6754;;

var _link_conf = nil;;           // config sector, read once at init
var _link_last_rx_frames = -1;;
var _link_last_rx_ms = 0;;
var _link_probe_ms = 0;;
var _link_reassoc_ms = 0;;       // 0 = never
var _link_reassoc_fails = 0;;
var stat_reassoc = 0;;

fun _reboot_task task =
    reboot REBOOT_KEY1 REBOOT_KEY2;
    TaskStop;;

// Deferred so the ack or log line leaves the radio before the VM dies.
fun reboot_soon =
    task_start_ex "reboot" 250 #_reboot_task;
    0;;

// Pure decision, unit tested: state is netState, ages in ms.
// reassoc_age nil = never attempted; fails = attempts since last RX.
fun link_decide state rx_age reassoc_age fails =
    if (reassoc_age != nil) && (reassoc_age < LINK_REASSOC_GRACE_MS) then
        LINK_ACT_NONE
    else if (state == NET_SCANNING) || (state == NET_CONNECTING) then
        // The driver is already trying; only step in if that never ends.
        (if rx_age > (LINK_RX_DEAD_MS * 2) then LINK_ACT_REBOOT else LINK_ACT_NONE)
    else if fails >= LINK_REBOOT_AFTER then LINK_ACT_REBOOT
    else if state != NET_CONNECTED then LINK_ACT_REASSOC
    else if rx_age > LINK_RX_DEAD_MS then LINK_ACT_REASSOC
    else if rx_age > LINK_RX_PROBE_MS then LINK_ACT_PROBE
    else LINK_ACT_NONE;;

// Any answer bumps stat_rx_frames; the gateway is the surest responder.
fun _link_probe =
    arp_request (if net_gateway != nil then net_gateway else CLAPIER_IP);
    0;;

// Scan for our SSID and re-authenticate with the config sector's
// credentials. WPA/WPA2 hand the PMK with auth 0 (the handshake is the
// authentication); WEP is not carried. netScan BLOCKS the radio and
// the VM for seconds — only ever called when the link is already gone.
// In the simulator netScan must not be called twice (its result
// counter is only reset on the device path).
fun link_reassoc =
    set stat_reassoc = stat_reassoc + 1;
    set _link_reassoc_ms = time_ms;
    set _link_reassoc_fails = _link_reassoc_fails + 1;
    if _link_conf == nil then (log_send "reassoc: no config"; 0)
    else
    let conf_ssid _link_conf -> ssid in
    let conf_crypt _link_conf -> crypt in
    if (strlen ssid) == 0 then (log_send "reassoc: no ssid in config"; 0)
    else if (crypt != CRYPT_NONE) && (crypt != CRYPT_WPA) && (crypt != CRYPT_WPA2) then
        (log_send "reassoc: unsupported crypt"; 0)
    else
    (
        log_send (strcat "reassoc: scanning " ssid);
#ifdef SIMU
        // The sim's netScan result counter is only reset on the device
        // path; a second call there corrupts the VM stack. Never scan.
        let nil -> scans in
#else
        let netScan ssid -> scans in
#endif
        if scans == nil then (log_send "reassoc: ssid not found"; 0)
        else
        (
            netAuth (hd scans) 0 crypt
                (if crypt == CRYPT_NONE then nil else conf_pmk _link_conf);
            log_send "reassoc: auth sent";
            1
        )
    );;

fun _link_watch task =
    let time_ms -> now in
    (
        if stat_rx_frames != _link_last_rx_frames then
        (
            set _link_last_rx_frames = stat_rx_frames;
            set _link_last_rx_ms = now;
            if _link_reassoc_fails != 0 then
            (
                // Back from the dead: tell the LAN where we live.
                set _link_reassoc_fails = 0;
                log_send "link: rx alive again";
                arp_announce;
                0
            )
            else 0
        )
        else 0;
        let link_decide netState (now - _link_last_rx_ms)
            (if _link_reassoc_ms == 0 then nil else now - _link_reassoc_ms)
            _link_reassoc_fails -> act in
        if act == LINK_ACT_PROBE then
        (
            if (now - _link_probe_ms) > LINK_PROBE_EVERY_MS then
                (set _link_probe_ms = now; _link_probe)
            else 0
        )
        else if act == LINK_ACT_REASSOC then (link_reassoc; 0)
        else if act == LINK_ACT_REBOOT then
        (
            log_send "link: radio dead, rebooting";
            reboot_soon
        )
        else 0;
        TaskRun
    );;

// The one-line identity card for ctl conf. The PMK never leaves.
fun link_conf_summary =
    if _link_conf == nil then "conf unread"
    else strcatlist
        "conf ssid=" :: (conf_ssid _link_conf) ::
        " auth=" :: (itoa (conf_auth _link_conf)) ::
        " crypt=" :: (itoa (conf_crypt _link_conf)) ::
        " magic=" :: (itoa (conf_magic _link_conf)) ::
        " srv=" :: (conf_server _link_conf) ::
        " srvip=" :: (let conf_server_ip _link_conf -> sip in
                      if sip == nil then "-" else ip_str sip) :: nil;;

fun link_init =
    set _link_conf = conf_read;
    set _link_last_rx_ms = time_ms;
    task_start_ex "watch" LINK_CHECK_MS #_link_watch;
    0;;
