// TCP, client and server. Minimal and correct on a quiet LAN:
//
// - one reliable segment in flight upstream (stop and wait), plus a TX
//   queue: tcp_write chunks anything larger than MSS and the queue
//   drains one segment per ack — that is how a stop-and-wait machine
//   serves a response bigger than one segment;
// - in-order-only receive: a segment is accepted iff its seq is exactly
//   rcv_nxt, anything else is dropped and re-ACKed; the peer's
//   retransmissions heal the gaps;
// - the advertised receive window is per connection (tcp_set_rwnd):
//   a bulk consumer (the audio stream) shrinks its own so one transfer
//   cannot saturate the half-duplex radio, and may close it to zero
//   while its buffer digests. Shrinking rides whatever we send next;
//   growth is announced by a bare ACK on the next timer tick. The
//   window only paces the sender: in-order data is always accepted;
// - sequence numbers live as 4-byte strings (VM ints are 31-bit),
//   compared with strcmp, advanced with seq_add;
// - listen: a SYN to a tcp_listen port spawns a connection driven by
//   the same machine (SYN_RCVD then ESTAB). No RST is ever sent:
//   segments to nowhere get LAN silence, like a quiet firewall;
// - no congestion control, TIME_WAIT skipped.
//
// The RX edge is tcp_input (fed by net/rx.mtl); the TX edge is
// _tcp_emit, which tests redirect through _tcp_send_hook.

const TCP_CLOSED = 0;;
const TCP_ARP_WAIT = 1;;
const TCP_SYN_SENT = 2;;
const TCP_ESTAB = 3;;
const TCP_FIN_WAIT_1 = 4;;
const TCP_FIN_WAIT_2 = 5;;
const TCP_LAST_ACK = 6;;
const TCP_SYN_RCVD = 7;;
const TCP_CLOSE_WAIT = 8;;  // peer closed first while our TX queue drains

const TCP_FLAG_FIN = 1;;
const TCP_FLAG_SYN = 2;;
const TCP_FLAG_RST = 4;;
const TCP_FLAG_PSH = 8;;
const TCP_FLAG_ACK = 16;;

const TCP_MSS = 536;;
const TCP_WINDOW = 4380;;
const TCP_MAX_CONNS = 6;;   // enough for a browser page plus a fetch
const TCP_TICK_MS = 100;;
const TCP_RTO_MS = 400;;
const TCP_MAX_RETRIES = 6;;

// Events delivered to the connection callback as: call cb [conn ev data]
const TCP_EV_CONNECTED = 1;;
const TCP_EV_DATA = 2;;      // data = payload string
const TCP_EV_CLOSED = 3;;    // orderly close, everything delivered
const TCP_EV_ERROR = 4;;     // data = reason string

type Tcp = [
    tcp_state
    tcp_rip tcp_rport tcp_lport
    tcp_rmac
    tcp_snd_nxt      // 4-byte string: next seq we would use
    tcp_rcv_nxt      // 4-byte string: next seq we expect
    tcp_unacked      // frame kept for retransmit, or nil
    tcp_sent_ms      // last (re)transmit, also ARP wait bookkeeping
    tcp_retries
    tcp_cb
    tcp_user         // free slot for the layer above (http)
    tcp_txq          // list of <=MSS payload strings awaiting their turn
    tcp_close_after  // FIN when the queue is drained
    tcp_rwnd         // receive window we advertise
    tcp_rwnd_push    // window growth awaiting its bare-ACK announcement
];;

var _tcp_conns = nil;;
var _tcp_listeners = nil;;   // list of [port cb]
var _tcp_lport_next = 0xC000;;
var _tcp_send_hook = nil;;
var _tcp_iss_force = nil;;   // test seam: next ISS, consumed once

// lowrate on, like every frame we emit: the driver's full-rate TX path
// proved unreliable on this rig (SYNs vanished at speed 0), and the
// reference stack of the era sent all its TCP at lowrate too.
fun _tcp_emit frame mac =
    if _tcp_send_hook != nil then call _tcp_send_hook [frame mac]
    else netSend frame 0 nil mac 0 1;;

fun _tcp_iss =
    if _tcp_iss_force != nil then
        let _tcp_iss_force -> s in (set _tcp_iss_force = nil; s)
    else strcat (word2 ((time_ms >> 16) & 0x7FFF)) (word2 (time_ms & 0xFFFF));;

// TCP header (+MSS option on SYN) + payload, checksummed over the IPv4
// pseudo header toward rip. ack may be nil when the ACK flag is absent.
fun tcp_segment rip lport rport seq ack flags wnd payload =
    let if payload == nil then "" else payload -> pl in
    let if (flags & TCP_FLAG_SYN) != 0 then strcat "\$02\$04" (word2 TCP_MSS) else "" -> opts in
    let 20 + (strlen opts) -> hdrlen in
    let strcatlist
        (word2 lport) :: (word2 rport) ::
        seq ::
        (if ack == nil then "\$00\$00\$00\$00" else ack) ::
        (ctoa ((hdrlen / 4) << 4)) ::
        (ctoa flags) ::
        (word2 wnd) ::
        "\$00\$00\$00\$00" ::         // checksum + urgent, patched below
        opts :: pl :: nil
    -> seg in
    let chk_final
        (netChk seg 0 nil
        (netChk (word2 (strlen seg)) 0 2
        (netChk "\$00\$06" 0 2      // zero + protocol 6
        (netChk (strcat NET_IP rip) 0 8 0)))) -> chk in
    (
        strputword seg 16 (if chk == 0 then 0xFFFF else chk);
        seg
    );;

fun _tcp_frame conn flags payload =
    let tcp_segment conn.tcp_rip conn.tcp_lport conn.tcp_rport
        conn.tcp_snd_nxt
        (if (flags & TCP_FLAG_ACK) != 0 then conn.tcp_rcv_nxt else nil)
        flags conn.tcp_rwnd payload -> seg in
    let ipv4_header IPV4_PROTO_TCP NET_IP conn.tcp_rip (strlen seg) -> ip in
    strcatlist LLC_IPV4 :: ip :: seg :: nil;;

// Reliable send: kept for retransmit until its ack arrives. SYN and FIN
// consume one sequence number, payload consumes its length.
fun _tcp_send_rel conn flags payload =
    let _tcp_frame conn flags payload -> frame in
    (
        set conn.tcp_unacked = frame;
        set conn.tcp_sent_ms = time_ms;
        set conn.tcp_retries = 0;
        set conn.tcp_snd_nxt = seq_add conn.tcp_snd_nxt
            ((if payload == nil then 0 else strlen payload)
             + (if (flags & (TCP_FLAG_SYN | TCP_FLAG_FIN)) != 0 then 1 else 0));
        _tcp_emit frame conn.tcp_rmac
    );;

// Bare ACKs are fire-and-forget; the peer retransmits if one is lost.
fun _tcp_send_ack conn = _tcp_emit (_tcp_frame conn TCP_FLAG_ACK nil) conn.tcp_rmac;;

fun _tcp_event conn ev data =
    if conn.tcp_cb != nil then call conn.tcp_cb [conn ev data] else 0;;

fun _tcp_remove conn l =
    if l == nil then nil
    else if (hd l) == conn then tl l
    else (hd l) :: _tcp_remove conn (tl l);;

fun _tcp_die conn ev reason =
    set conn.tcp_state = TCP_CLOSED;
    set conn.tcp_unacked = nil;
    set _tcp_conns = _tcp_remove conn _tcp_conns;
    _tcp_event conn ev reason;;

fun _tcp_start_syn conn =
    set conn.tcp_state = TCP_SYN_SENT;
    _tcp_send_rel conn TCP_FLAG_SYN nil;;

fun _tcp_try_arp conn =
    let arp_lookup conn.tcp_rip -> mac in
    if mac != nil then (set conn.tcp_rmac = mac; _tcp_start_syn conn)
    else (arp_request conn.tcp_rip; 0);;

fun tcp_connect rip rport cb =
    let [tcp_state:TCP_ARP_WAIT tcp_rip:rip tcp_rport:rport
         tcp_lport:_tcp_lport_next tcp_rmac:nil
         tcp_snd_nxt:_tcp_iss tcp_rcv_nxt:"\$00\$00\$00\$00"
         tcp_unacked:nil tcp_sent_ms:time_ms tcp_retries:0
         tcp_cb:cb tcp_user:nil tcp_txq:nil tcp_close_after:0
         tcp_rwnd:TCP_WINDOW tcp_rwnd_push:0] -> conn in
    (
        set _tcp_lport_next = if _tcp_lport_next >= 0xFFF0 then 0xC000 else _tcp_lport_next + 1;
        set _tcp_conns = conn :: _tcp_conns;
        _tcp_try_arp conn;
        conn
    );;

// One reliable segment at a time: refused while one is still in flight.
fun tcp_send conn payload =
    if (conn.tcp_state == TCP_ESTAB) && (conn.tcp_unacked == nil) then
        (_tcp_send_rel conn (TCP_FLAG_ACK | TCP_FLAG_PSH) payload; 1)
    else 0;;

fun _tcp_lappend a b =
    if a == nil then b else (hd a) :: _tcp_lappend (tl a) b;;

fun _tcp_chunks data i =
    let (strlen data) - i -> left in
    if left <= 0 then nil
    else if left <= TCP_MSS then (strsub data i left) :: nil
    else (strsub data i TCP_MSS) :: _tcp_chunks data (i + TCP_MSS);;

// The queue engine: whenever nothing is in flight, send the next queued
// chunk; once drained, honor a pending close with our FIN. Called after
// every write, close and incoming ack.
fun _tcp_txq_kick conn =
    if ((conn.tcp_state != TCP_ESTAB) && (conn.tcp_state != TCP_CLOSE_WAIT))
        || (conn.tcp_unacked != nil) then 0
    else if conn.tcp_txq != nil then
        let hd conn.tcp_txq -> seg in
        (
            set conn.tcp_txq = tl conn.tcp_txq;
            _tcp_send_rel conn (TCP_FLAG_ACK | TCP_FLAG_PSH) seg;
            1
        )
    else if conn.tcp_close_after then
    (
        set conn.tcp_state =
            if conn.tcp_state == TCP_CLOSE_WAIT then TCP_LAST_ACK
            else TCP_FIN_WAIT_1;
        _tcp_send_rel conn (TCP_FLAG_ACK | TCP_FLAG_FIN) nil;
        1
    )
    else 0;;

// Queue any amount of data; chunked to MSS and drained by the acks.
fun tcp_write conn data =
    if ((conn.tcp_state == TCP_ESTAB) || (conn.tcp_state == TCP_CLOSE_WAIT))
        && (data != nil) && ((strlen data) > 0) then
    (
        set conn.tcp_txq = _tcp_lappend conn.tcp_txq (_tcp_chunks data 0);
        _tcp_txq_kick conn;
        1
    )
    else 0;;

// Receiver flow control: the layer above sets how much the peer may
// keep in flight toward us. Shrinking (or closing to zero) rides the
// next segment we send anyway; growth is worth announcing, so the
// timer sends a bare ACK for it — from a task, not from whatever
// callback decided to reopen.
fun tcp_set_rwnd conn wnd =
    if (wnd > conn.tcp_rwnd)
        && ((conn.tcp_state == TCP_ESTAB) || (conn.tcp_state == TCP_CLOSE_WAIT)) then
        set conn.tcp_rwnd_push = 1
    else 0;
    set conn.tcp_rwnd = wnd;
    0;;

// Orderly close, queue-aware: the FIN leaves once everything queued has
// been sent and acked.
fun tcp_close conn =
    if (conn.tcp_state == TCP_ESTAB) || (conn.tcp_state == TCP_CLOSE_WAIT) then
        (set conn.tcp_close_after = 1; _tcp_txq_kick conn; 1)
    else 0;;

fun tcp_listen port cb =
    set _tcp_listeners = [port cb] :: _tcp_listeners;
    0;;

fun _tcp_find l sip sport dport =
    if l == nil then nil
    else let hd l -> conn in
    if (conn.tcp_lport == dport) && (conn.tcp_rport == sport)
        && (!strcmp conn.tcp_rip sip) then conn
    else _tcp_find (tl l) sip sport dport;;

fun _tcp_find_listener l port =
    if l == nil then nil
    else let hd l -> [p cb] in
    if p == port then cb
    else _tcp_find_listener (tl l) port;;

fun _tcp_count l = if l == nil then 0 else 1 + _tcp_count (tl l);;

// A SYN landed on a listening port: spawn the connection and answer
// SYN+ACK straight back to the asking MAC (no ARP round trip, like the
// ICMP echo). Above the cap we stay silent and let the client retry.
// If the handshake ack never comes, the SYN+ACK retransmit timer buries
// the embryo on its own.
fun _tcp_accept frame macsrc =
    let _tcp_find_listener _tcp_listeners (strgetword frame 30) -> cb in
    if cb == nil then 0
    else if (_tcp_count _tcp_conns) >= TCP_MAX_CONNS then 0
    else
    let [tcp_state:TCP_SYN_RCVD tcp_rip:(ipv4_src frame)
         tcp_rport:(strgetword frame 28) tcp_lport:(strgetword frame 30)
         tcp_rmac:macsrc
         tcp_snd_nxt:_tcp_iss tcp_rcv_nxt:(seq_add (strsub frame 32 4) 1)
         tcp_unacked:nil tcp_sent_ms:time_ms tcp_retries:0
         tcp_cb:cb tcp_user:nil tcp_txq:nil tcp_close_after:0
         tcp_rwnd:TCP_WINDOW tcp_rwnd_push:0] -> conn in
    (
        set stat_tcp_accepts = stat_tcp_accepts + 1;
        set _tcp_conns = conn :: _tcp_conns;
        _tcp_send_rel conn (TCP_FLAG_SYN | TCP_FLAG_ACK) nil;
        0
    );;

// The ack we sent our last reliable segment under is snd_nxt; with one
// segment in flight, equality means everything is acked.
fun _tcp_ack_in conn seg_flags seg_ack =
    if ((seg_flags & TCP_FLAG_ACK) != 0) && (conn.tcp_unacked != nil)
        && (!strcmp seg_ack conn.tcp_snd_nxt) then
    (
        set conn.tcp_unacked = nil;
        if conn.tcp_state == TCP_SYN_RCVD then
            (set conn.tcp_state = TCP_ESTAB; _tcp_event conn TCP_EV_CONNECTED nil)
        else if conn.tcp_state == TCP_FIN_WAIT_1 then set conn.tcp_state = TCP_FIN_WAIT_2
        else if conn.tcp_state == TCP_LAST_ACK then _tcp_die conn TCP_EV_CLOSED nil
        else _tcp_txq_kick conn
    )
    else 0;;

// Ack before delivering: the event callback usually answers on the
// spot (the http server does), and its segment must follow our ack of
// what it answers to.
fun _tcp_data_in conn payload =
    if (strlen payload) == 0 then 0
    else
    (
        set conn.tcp_rcv_nxt = seq_add conn.tcp_rcv_nxt (strlen payload);
        _tcp_send_ack conn;
        _tcp_event conn TCP_EV_DATA payload;
        1
    );;

fun _tcp_fin_in conn =
    set conn.tcp_rcv_nxt = seq_add conn.tcp_rcv_nxt 1;
    if conn.tcp_state == TCP_ESTAB then
    (
        if (conn.tcp_unacked == nil) && (conn.tcp_txq == nil) then
        (
            // Nothing left to send: our FIN rides the ACK.
            set conn.tcp_state = TCP_LAST_ACK;
            _tcp_send_rel conn (TCP_FLAG_ACK | TCP_FLAG_FIN) nil
        )
        else
        (
            // A response is still leaving: ACK the FIN, keep draining,
            // FIN when done. No half-close users here, so closing after
            // the drain is always right.
            set conn.tcp_state = TCP_CLOSE_WAIT;
            set conn.tcp_close_after = 1;
            _tcp_send_ack conn
        )
    )
    else
    (
        // FIN_WAIT_2 (or simultaneous close): final ACK and done.
        _tcp_send_ack conn;
        _tcp_die conn TCP_EV_CLOSED nil
    );;

// frame is ipv4_valid with proto TCP. Bad checksums and unknown
// connections are dropped silently; everything else drives the machine.
fun tcp_input frame macsrc =
    let (ipv4_totlen frame) - IPV4_HDR_LEN -> seg_len in
    if seg_len < 20 then 0
    else if (chk_final
        (netChk frame 28 seg_len
        (netChk (word2 seg_len) 0 2
        (netChk "\$00\$06" 0 2
        (netChk (strsub frame 20 8) 0 8 0))))) != 0 then 0
    else
    let strget frame 41 -> flags in
    let _tcp_find _tcp_conns (ipv4_src frame) (strgetword frame 28) (strgetword frame 30) -> conn in
    if conn == nil then
    (
        // Only a fresh SYN to a listening port opens something; every
        // other stray segment is dropped without a RST.
        if ((flags & TCP_FLAG_SYN) != 0) && ((flags & TCP_FLAG_ACK) == 0) then
            _tcp_accept frame macsrc
        else 0
    )
    else
    let strsub frame 32 4 -> seg_seq in
    let strsub frame 36 4 -> seg_ack in
    let ((strget frame 40) >> 4) * 4 -> doff in
    let seg_len - doff -> plen in
    if (flags & TCP_FLAG_RST) != 0 then
        (_tcp_die conn TCP_EV_ERROR "reset by peer"; 0)
    else if conn.tcp_state == TCP_SYN_SENT then
    (
        if ((flags & TCP_FLAG_SYN) != 0) && ((flags & TCP_FLAG_ACK) != 0)
            && (!strcmp seg_ack conn.tcp_snd_nxt) then
        (
            set conn.tcp_unacked = nil;
            set conn.tcp_rcv_nxt = seq_add seg_seq 1;
            set conn.tcp_state = TCP_ESTAB;
            _tcp_send_ack conn;
            _tcp_event conn TCP_EV_CONNECTED nil
        )
        else 0
    )
    else
    (
        _tcp_ack_in conn flags seg_ack;
        if conn.tcp_state == TCP_CLOSED then 0
        else if !strcmp seg_seq conn.tcp_rcv_nxt then
        (
            if plen > 0 then _tcp_data_in conn (strsub frame (28 + doff) plen) else 0;
            if (flags & TCP_FLAG_FIN) != 0 then _tcp_fin_in conn else 0
        )
        else
            // Not what we expect next: drop and restate our ack.
            (_tcp_send_ack conn; 0)
    );;

fun _tcp_tick_conn conn now =
    if conn.tcp_rwnd_push
        && ((conn.tcp_state == TCP_ESTAB) || (conn.tcp_state == TCP_CLOSE_WAIT)) then
        (set conn.tcp_rwnd_push = 0; _tcp_send_ack conn; 0)
    else 0;
    if conn.tcp_state == TCP_ARP_WAIT then
    (
        if (now - conn.tcp_sent_ms) > TCP_RTO_MS then
        (
            set conn.tcp_sent_ms = now;
            set conn.tcp_retries = conn.tcp_retries + 1;
            if conn.tcp_retries > TCP_MAX_RETRIES then
                _tcp_die conn TCP_EV_ERROR "arp timeout"
            else _tcp_try_arp conn
        )
        else 0
    )
    else if (conn.tcp_unacked != nil) && ((now - conn.tcp_sent_ms) > TCP_RTO_MS) then
    (
        set conn.tcp_retries = conn.tcp_retries + 1;
        if conn.tcp_retries > TCP_MAX_RETRIES then
            _tcp_die conn TCP_EV_ERROR "retransmit timeout"
        else
        (
            set stat_tcp_retx = stat_tcp_retx + 1;
            set conn.tcp_sent_ms = now;
            _tcp_emit conn.tcp_unacked conn.tcp_rmac
        )
    )
    else 0;;

fun _tcp_timer task =
    let time_ms -> now in
    for l = _tcp_conns; l != nil; tl l do
        _tcp_tick_conn (hd l) now;
    TaskRun;;

fun tcp_init =
    task_start_ex "tcp" TCP_TICK_MS #_tcp_timer;
    0;;
